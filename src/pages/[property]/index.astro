---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import { filesOf, shortTitle } from '../../../shared/files';
import { PROPERTIES } from '../../../shared/properties';

// One tree per property. The prefix never reaches the browser: the middleware
// rewrites `/` onto it based on the request host.
export function getStaticPaths() {
  return PROPERTIES.map((property) => ({
    params: { property: property.slug },
    props: { property },
  }));
}

const { property } = Astro.props;

// Catalog titles already carry the property name in front; here that would be
// repeated once per document right under the page's own title.
const items = filesOf(property.slug).map((f) => ({ ...f, shortTitle: shortTitle(f) }));
---
<Layout title={`${property.displayName} — ${property.brand}`} property={property}>
  <main class="card">
    <p class="brand">{property.brand}</p>

    <h1>
      <a
        href={property.homeUrl}
        class="home-link"
        title={`${property.brand} home`}
        aria-label={`${property.brand} home`}
      >
        <svg
          class="home-icon"
          viewBox="2.1 3.1 19.8 17.8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M3 11.5 12 4l9 7.5" />
          <path d="M5.5 10v9a1 1 0 0 0 1 1h3v-6h5v6h3a1 1 0 0 0 1-1v-9" />
        </svg>
      </a>
      {property.displayName}
    </h1>
    <hr class="rule" />
    <p class="description">{property.tagline}</p>

    <ul class="materials">
      {items.map((f) => (
        <li>
          <a href={`/d/${f.slug}/`}>
            <span class="material-title">{f.shortTitle}</span>
            <span class="material-desc">{f.description}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="footnote">
      An access code is required.<br />
      This material is confidential and shared by invitation only.
    </p>
  </main>
</Layout>
