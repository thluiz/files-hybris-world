---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import { FILES } from '../../../shared/files';

export function getStaticPaths() {
  return FILES.map((file) => ({
    params: { slug: file.slug },
    props: { file },
  }));
}

const { file } = Astro.props;
---
<Layout title={`${file.title} — Metron Showrunners`}>
  <main class="card">
    <p class="brand">Metron Showrunners</p>

    <h1>
      <a
        href="/"
        class="title-link"
        title="Back to all documents"
        aria-label={`${file.title} — back to all documents`}
      >
        <svg
          class="title-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M9.5 6.5h11" />
          <path d="M9.5 12h11" />
          <path d="M9.5 17.5h11" />
          <path d="M4 6.5h.01" />
          <path d="M4 12h.01" />
          <path d="M4 17.5h.01" />
        </svg>
        <span>{file.title}</span>
      </a>
    </h1>
    <p class="description">{file.description}</p>
    <hr class="rule" />

    <p class="error" id="error" hidden role="alert"></p>

    <form method="POST" action="/api/download">
      <input type="hidden" name="slug" value={file.slug} />
      <label for="code">Access code</label>
      <input
        id="code"
        name="code"
        type="text"
        required
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="12"
        placeholder="XXXX-XXXX"
      />
      <button type="submit">Access Content</button>
    </form>

    <a class="back-link" href="/">
      <svg
        class="back-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M9.5 6.5h11" />
        <path d="M9.5 12h11" />
        <path d="M9.5 17.5h11" />
        <path d="M4 6.5h.01" />
        <path d="M4 12h.01" />
        <path d="M4 17.5h.01" />
      </svg>
      <span>All documents</span>
    </a>

    <p class="footnote">
      This material is confidential and shared by invitation only.
    </p>
  </main>
</Layout>

<script is:inline>
  // The page is static, so the error message comes via the query string that the
  // Function appends on the redirect back.
  const reason = new URLSearchParams(location.search).get('erro');
  if (reason) {
    const box = document.getElementById('error');
    const messages = {
      rate: 'Too many attempts. Please wait a few minutes and try again.',
      // Code on the list, but for a document not granted to it.
      nivel: 'Your access code does not cover this document. Please contact Metron Showrunners.',
    };
    box.textContent = messages[reason] || 'That access code is not valid.';
    box.hidden = false;
    document.getElementById('code').focus();
  }
</script>
