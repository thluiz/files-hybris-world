---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Material restrito: nada aqui deve aparecer em buscador. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#cabf9d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <footer class="ip-notice">
      <p class="ip-notice-title">Intellectual Property Notice</p>
      <p>
        All content on this page is private intellectual property of Metron
        Showrunners and its respective rights holders. Any reproduction,
        modification, sharing, distribution, or use, in whole or in part, is
        prohibited without the prior express written authorization of Metron
        Showrunners.
      </p>
      <p>All rights reserved.</p>
    </footer>
  </body>
</html>
