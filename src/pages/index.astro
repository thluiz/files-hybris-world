---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { FILES } from '../../shared/files';

// Catalog titles already carry "Hybris —" in front; here that would be
// repeated four times right under the page's own title.
const items = FILES.map((f) => ({
  ...f,
  shortTitle: f.title.replace(/^Hybris\s*—\s*/, ''),
}));
---
<Layout title="Hybris Project — Metron Showrunners">
  <main class="card">
    <p class="brand">Metron Showrunners</p>

    <h1>
      <a
        href="https://metronshowrunners.com"
        class="home-link"
        title="Metron Showrunners home"
        aria-label="Metron Showrunners home"
      >
        <svg
          class="home-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M3 11.5 12 4l9 7.5" />
          <path d="M5.5 10v9a1 1 0 0 0 1 1h3v-6h5v6h3a1 1 0 0 0 1-1v-9" />
        </svg>
      </a>
      Hybris Project
    </h1>
    <hr class="rule" />
    <p class="description">
      An Ancient Conflict, Reimagined. Select a document to continue.
    </p>

    <ul class="materials">
      {items.map((f) => (
        <li>
          <a href={`/d/${f.slug}`}>
            <span class="material-title">{f.shortTitle}</span>
            <span class="material-desc">{f.description}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="footnote">
      An access code is required.<br />
      This material is confidential and shared by invitation only.
    </p>
  </main>
</Layout>
